---
services:

  postgres-db:
    image: postgres:17.6-alpine3.22
    container_name: postgres
    hostname: postgres
    restart: always
    ports:
      - 5411:5432
    env_file:
      - .env
    volumes:
      - postgres:/var/lib/postgresql/data
    healthcheck:
      test: pg_isready -U postgres
      interval: 10s
      timeout: 5s
      retries: 15
    networks:
      - poc

  keycloak:
    container_name: keycloak
    image: keycloak/keycloak:26.4
    restart: unless-stopped
    hostname: keycloak
    command: start-dev --import-realm
    ports:
      - "8080:8080"
      - "9090:9000"
    depends_on:
      postgres-db:
        condition: service_healthy
    # depends_on:
    #   - postgres-db
    volumes:
      - ./keycloak:/opt/keycloak/data/import:ro
    env_file:
      - .env
    environment:
      KC_HEALTH_ENABLED: "true"
    # extra_hosts:
    #   - "test.example.local:192.168.0.153"
    healthcheck:
      test: ["CMD-SHELL", "{ printf 'HEAD /health/ready HTTP/1.0\r\n\r\n' >&0; grep 'HTTP/1.0 200'; } 0<>/dev/tcp/localhost/9000 || exit 1"]
      interval: 15s
      timeout: 10s
      retries: 5
      start_period: 90s
    networks:
      - poc

  # nginx:
  #   image: nginx:1.25-alpine
  #   container_name: nginx
  #   restart: always
  #   expose:
  #     - "8081"
  #   # ports:
  #   #   - 80:80
  #   # - 443:443
  #   volumes:
  #     - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
  #     - ./nginx/web:/usr/share/nginx/html:ro
  #   networks:
  #     - poc

  oauth2-proxy:
    image: quay.io/oauth2-proxy/oauth2-proxy:v7.6.0
    container_name: oauth2-proxy
    restart: always
    depends_on:
      keycloak:
        condition: service_healthy
      # nginx:
      #   condition: service_started
    # depends_on:
    #   - keycloak
    #   - nginx
    ports:
      - "4180:4180"
    env_file:
      - .env
    extra_hosts:
      - "test.example.local:192.168.0.153"
    networks:
      - poc

volumes:
  postgres:
    driver: local
    name: postgres
networks:
  poc:
    driver: bridge